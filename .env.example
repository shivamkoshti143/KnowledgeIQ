# Application
PORT=4001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=knowledgeiq

# JWT
JWT_SECRET=your-super-secure-random-secret-key-min-32-chars

# Microsoft Entra ID / Azure AD Configuration
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_REDIRECT_URI=https://your-domain.com/api/auth/microsoft/callback
MICROSOFT_AUTO_PROVISION=true

# Microsoft Teams Bot Configuration (Legacy / Historical)
MICROSOFT_BOT_ID=your-bot-id
MICROSOFT_BOT_PASSWORD=your-bot-password

# Microsoft OAuth & Graph Configuration
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
MICROSOFT_GRAPH_ENDPOINT=https://graph.microsoft.com

# Allowed email domains for registration/login
ALLOWED_EMAIL_DOMAINS=abmindia.com,abm.com

# Email / SMTP Configuration (fallback)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@company.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@company.com

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=10

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_MAX_REQUESTS=20

# Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Application Name (used in OTP messages)
APP_NAME=ABM TaskIQ