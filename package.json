    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
